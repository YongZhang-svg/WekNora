# WeKnora Sandbox Image
# Pre-built environment for executing agent skill scripts in Docker sandbox
# Multi-stage build, minimal dependencies

# Stage 1: Get Node.js binaries
FROM node:20-slim AS node-base

# Stage 2: Final image
FROM python:3.11-slim

# Copy Node.js from node image (avoids NodeSource install overhead)
COPY --from=node-base /usr/local/bin/node /usr/local/bin/
COPY --from=node-base /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && \
    ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

# Install minimal CLI tools (bash/grep/sed/coreutils already in slim image)
# Also install Chromium dependencies for mermaid-cli (mmdc) rendering
# And graphviz for diagrams library, texlive for matplotlib LaTeX rendering
RUN apt-get update && apt-get install -y --no-install-recommends \
    jq \
    chromium \
    fonts-noto-cjk \
    graphviz \
    texlive-base \
    texlive-pictures \
    texlive-latex-extra \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/*

# Configure Puppeteer to use system Chromium instead of downloading its own
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Install mermaid-cli (mmdc) for rendering .mmd -> .png/.svg
# Uses system Chromium via puppeteer-config.json
# PUPPETEER_SKIP_DOWNLOAD prevents npm from downloading Chromium during install
COPY docker/puppeteer-config.json /etc/mermaid-cli/puppeteer-config.json
RUN npm install -g @mermaid-js/mermaid-cli

# Bundle mermaid.js for offline HTML rendering fallback
# Copy from the installed mermaid-cli node_modules to a shared location
# RUN mkdir -p /usr/local/share/mermaid && \
#     cp /usr/local/lib/node_modules/@mermaid-js/mermaid-cli/node_modules/@mermaid-js/mermaid/dist/mermaid.min.js /usr/local/share/mermaid/mermaid.min.js && \
#     chmod 644 /usr/local/share/mermaid/mermaid.min.js

RUN mkdir -p /usr/local/share/mermaid && \
    MERMAID_FILE=$(find /usr/local/lib/node_modules -name mermaid.min.js -path "*/dist/*" | head -1) && \
    if [ -z "$MERMAID_FILE" ]; then echo "mermaid.min.js not found"; exit 1; fi && \
    cp "$MERMAID_FILE" /usr/local/share/mermaid/mermaid.min.js && \
    chmod 644 /usr/local/share/mermaid/mermaid.min.js
# Install Python packages required by preloaded skills
RUN pip install --no-cache-dir \
    diagrams \
    matplotlib \
    seaborn \
    plotly \
    networkx \
    pillow

# Note: Add more Python packages here when skills need them

# Create non-root user (UID 1000) for sandbox execution
RUN groupadd -g 1000 sandbox && \
    useradd -u 1000 -g sandbox -m -s /bin/bash sandbox

WORKDIR /workspace
USER sandbox
